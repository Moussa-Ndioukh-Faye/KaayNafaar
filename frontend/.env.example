# ============================================
# Kaay Nafaar — Configuration Frontend
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# URL de l'API backend
# En développement : laisser vide (utilise le proxy Vite)
# En production : https://api.votre-domaine.com
VITE_API_URL=

# Host pour le serveur de développement Vite
VITE_HOST=localhost

# URL publique du backend (envoi direct des fichiers, sans passer par le proxy Vercel)
VITE_BACKEND_URL=https://kaay-nafaar-api-1rtt.onrender.com
