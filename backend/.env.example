# ============================================
# Kaay Nafaar — Configuration Backend
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USER=user_admin
DB_PASSWORD=password_secret
DB_NAME=kaay_nafaar_v2

# JWT
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_EXPIRE=7d

# Cookies
COOKIE_SECRET=change_me_to_a_random_64_char_hex_string

# IA Providers (au moins un requis)
# Google Gemini API
GEMINI_API_KEY=
# GROQ API
GROQ_API_KEY=
# OpenAI API (optionnel)
OPENAI_API_KEY=

# Web Search (optionnel)
TAVILY_API_KEY=

# Serveur
PORT=5001
NODE_ENV=development

# Base hébergée (Supabase, Neon…) : remplace les variables DB_* ci-dessus, SSL automatique
# Supabase : utiliser le « Session pooler » (IPv4), port 5432
# DATABASE_URL=postgresql://UTILISATEUR.REF_PROJET:MOT_DE_PASSE@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Frontend URL (pour CORS et CSRF — séparées par des virgules, liste blanche stricte)
FRONTEND_URL=http://localhost:3000,http://localhost:5173
# Optionnel : regex pour autoriser les previews Vercel de CE projet uniquement
# CORS_ORIGIN_REGEX=^https://kaay-nafaar-[a-z0-9]+-votre-equipe\.vercel\.app$

# Redis (optionnel — utilise un mock en mémoire si indisponible)
REDIS_HOST=localhost
REDIS_PORT=6379
