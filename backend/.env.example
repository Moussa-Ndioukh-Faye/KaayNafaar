# Renommer ce fichier en .env et remplir les valeurs

# MongoDB
MONGO_URI=mongodb://localhost:27017/revision_app

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_securise
JWT_EXPIRE=7d

# Claude API (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Serveur
PORT=5001
NODE_ENV=development

# Frontend URL (pour CORS — Vite tourne sur 5173 par défaut)
FRONTEND_URL=http://localhost:5173
