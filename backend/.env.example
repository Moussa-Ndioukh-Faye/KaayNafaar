# ============================================
# Kaay Nafaar — Configuration Backend
# Copier ce fichier en .env et remplir les valeurs
# ============================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USER=user_admin
DB_PASSWORD=password_secret
DB_NAME=kaay_nafaar_v2

# JWT
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_EXPIRE=7d

# Cookies
COOKIE_SECRET=change_me_to_a_random_64_char_hex_string

# IA Providers (au moins un requis)
# Google Gemini API
GEMINI_API_KEY=
# GROQ API
GROQ_API_KEY=
# OpenAI API (optionnel)
OPENAI_API_KEY=

# Web Search (optionnel)
TAVILY_API_KEY=

# Serveur
PORT=5001
NODE_ENV=development

# Base hébergée (Supabase, Neon…) : remplace les variables DB_* ci-dessus, SSL automatique
# Supabase : utiliser le « Session pooler » (IPv4), port 5432
# DATABASE_URL=postgresql://UTILISATEUR.REF_PROJET:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Frontend URL (pour CORS et CSRF — séparées par des virgules, liste blanche stricte)
FRONTEND_URL=http://localhost:3000,http://localhost:5173
# Optionnel : regex pour autoriser les previews Vercel de CE projet uniquement
# CORS_ORIGIN_REGEX=^https://kaay-nafaar-[a-z0-9]+-votre-equipe\.vercel\.app$

# Redis (optionnel — utilise un mock en mémoire si indisponible)
REDIS_HOST=localhost
REDIS_PORT=6379

# Vérification des emails — API Brevo (gratuit : 300 emails/jour). Sans clé, la vérification est désactivée
# (en développement, forcer avec EMAIL_VERIFICATION=true : le lien s'affiche dans la console)
BREVO_API_KEY=
MAIL_FROM=adresse-verifiee-dans-brevo@example.com
MAIL_FROM_NAME=Kaay Nafaar
# URL publique du frontend utilisée dans les liens des emails (sinon : 1re valeur de FRONTEND_URL)
APP_URL=https://kaay-nafaar.vercel.app

# Modèles IA (facultatif) — à changer quand un fournisseur retire un modèle
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GROQ_MODEL=llama-3.3-70b-versatile

# ── Sécurité ─────────────────────────────────────────────────────
# Nombre de proxys devant le serveur (IP réelle du client pour les limites).
# Local : 1 · Production Vercel → Render : 2
TRUST_PROXY=1
# Quotas quotidiens par utilisateur (IA et imports de cours)
AI_QUOTA_JOUR=100
IMPORTS_QUOTA_JOUR=20
# Alerte email en cas d'activité suspecte (5 échecs de connexion en 60 s par défaut)
SECURITY_ALERT_EMAIL=
SUSPICION_SEUIL=5
SUSPICION_FENETRE_MS=60000
