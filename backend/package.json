{
  "name": "kaay_nafaar-backend",
  "version": "1.0.0",
  "description": "Backend API pour Kaay_Nafaar",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "NODE_ENV=production node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"server.js\"",
    "db:migrate": "NODE_ENV=production DB_SYNC=alter node -e \"require('./src/config/database').connectDB().then(() => { console.log('Migration terminée'); process.exit(0); })\"",
    "db:sync": "NODE_ENV=production DB_SYNC=alter node server.js"
  },
  "dependencies": {
    "@langchain/community": "^1.1.28",
    "@langchain/google-genai": "^0.1.0",
    "@langchain/openai": "^1.4.5",
    "@langchain/textsplitters": "^1.0.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.4.0",
    "multer": "^2.0.0",
    "openai": "^6.38.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.0.0",
    "nodemon": "^3.1.3",
    "prettier": "^3.8.3",
    "sqlite3": "^6.0.1",
    "supertest": "^6.0.0"
  }
}
